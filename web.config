<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Configuración de Proxy Inverso para IIS (ARR + URL Rewrite hacia Node.js en puerto 3001) -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNodeJS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:0}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Asegurar tipos MIME estándar para assets web -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- Permitir que las respuestas de error del backend pasen a través de IIS -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
